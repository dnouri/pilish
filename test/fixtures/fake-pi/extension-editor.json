{
  "description": "Extension multiline editor flow without a timeout or abort signal.",
  "commands": [
    {
      "name": "test-editor",
      "description": "Trigger fake extension editor",
      "source": "extension",
      "sourceInfo": { "scope": "project", "path": "test-extension.ts" }
    }
  ],
  "prompt": {
    "type": "extension_dialog",
    "command_name": "/test-editor",
    "method": "editor",
    "title": "Spike Editor",
    "prefill": "first line\nsecond line",
    "response_messages": {
      "value": "EDITOR SUBMITTED",
      "cancelled": "EDITOR CANCELLED"
    }
  }
}
